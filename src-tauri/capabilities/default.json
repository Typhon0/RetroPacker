{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for the main window",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"shell:default",
		"shell:allow-kill",
		"dialog:default",
		"notification:default",
		"opener:default",
		"opener:allow-reveal-item-in-dir",
		{
			"identifier": "opener:allow-open-path",
			"allow": [
				{
					"path": "**"
				}
			]
		},
		{
			"identifier": "shell:allow-execute",
			"allow": [
				{
					"name": "binaries/chdman",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/chdman-aarch64-apple-darwin",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/chdman-x86_64-apple-darwin",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/chdman-x86_64-pc-windows-msvc.exe",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/chdman-x86_64-unknown-linux-gnu",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/DolphinTool",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/DolphinTool-aarch64-apple-darwin",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/DolphinTool-x86_64-apple-darwin",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/DolphinTool-x86_64-pc-windows-msvc.exe",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/DolphinTool-x86_64-unknown-linux-gnu",
					"sidecar": true,
					"args": true
				},
				{
					"name": "taskkill",
					"cmd": "taskkill",
					"args": true
				},
				{
					"name": "kill",
					"cmd": "kill",
					"args": true
				},
				{
					"name": "powershell",
					"cmd": "powershell",
					"args": true
				},
				{
					"name": "osascript",
					"cmd": "osascript",
					"args": true
				},
				{
					"name": "gio",
					"cmd": "gio",
					"args": true
				}
			]
		},
		{
			"identifier": "shell:allow-spawn",
			"allow": [
				{
					"name": "binaries/chdman",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/chdman-aarch64-apple-darwin",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/chdman-x86_64-apple-darwin",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/chdman-x86_64-pc-windows-msvc.exe",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/chdman-x86_64-unknown-linux-gnu",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/DolphinTool",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/DolphinTool-aarch64-apple-darwin",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/DolphinTool-x86_64-apple-darwin",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/DolphinTool-x86_64-pc-windows-msvc.exe",
					"sidecar": true,
					"args": true
				},
				{
					"name": "binaries/DolphinTool-x86_64-unknown-linux-gnu",
					"sidecar": true,
					"args": true
				},
				{
					"name": "taskkill",
					"cmd": "taskkill",
					"args": true
				},
				{
					"name": "kill",
					"cmd": "kill",
					"args": true
				},
				{
					"name": "powershell",
					"cmd": "powershell",
					"args": true
				},
				{
					"name": "osascript",
					"cmd": "osascript",
					"args": true
				},
				{
					"name": "gio",
					"cmd": "gio",
					"args": true
				}
			]
		},
		"store:default",
		{
			"identifier": "http:default",
			"allow": [
				{
					"url": "https://raw.githubusercontent.com/**"
				},
				{
					"url": "https://art.gametdb.com/**"
				},
				{
					"url": "https://www.gametdb.com/**"
				}
			]
		},
		{
			"identifier": "fs:allow-read-file",
			"allow": [
				{
					"path": "$APPLOCALDATA/**"
				},
				{
					"path": "$APPDATA/**"
				},
				{
					"path": "**"
				}
			]
		},
		{
			"identifier": "fs:allow-read-dir",
			"allow": [
				{
					"path": "$APPLOCALDATA/**"
				},
				{
					"path": "$APPDATA/**"
				},
				{
					"path": "**"
				}
			]
		},
		{
			"identifier": "fs:allow-stat",
			"allow": [
				{
					"path": "$APPLOCALDATA/**"
				},
				{
					"path": "$APPDATA/**"
				},
				{
					"path": "**"
				}
			]
		},
		{
			"identifier": "fs:allow-read-text-file",
			"allow": [
				{
					"path": "$APPLOCALDATA/**"
				},
				{
					"path": "$APPDATA/**"
				}
			]
		},
		{
			"identifier": "fs:allow-write-file",
			"allow": [
				{
					"path": "$APPLOCALDATA/**"
				},
				{
					"path": "$APPDATA/**"
				},
				{
					"path": "$TEMP/**"
				},
				{
					"path": "**"
				}
			]
		},
		{
			"identifier": "fs:allow-mkdir",
			"allow": [
				{
					"path": "$APPLOCALDATA/**"
				},
				{
					"path": "$APPDATA/**"
				},
				{
					"path": "$TEMP/**"
				}
			]
		},
		{
			"identifier": "fs:allow-remove",
			"allow": [
				{
					"path": "$APPLOCALDATA/**"
				},
				{
					"path": "$APPDATA/**"
				},
				{
					"path": "$TEMP/**"
				}
			]
		},
		{
			"identifier": "fs:allow-exists",
			"allow": [
				{
					"path": "$APPLOCALDATA/**"
				},
				{
					"path": "$APPDATA/**"
				},
				{
					"path": "**"
				}
			]
		},
		"os:default",
		{
			"identifier": "fs:allow-read",
			"allow": [
				{
					"path": "**"
				}
			]
		},
		"core:window:allow-set-progress-bar"
	]
}
